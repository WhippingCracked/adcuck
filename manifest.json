{
  "manifest_version": 3,
  "name": "AdCuck",
  "version": "1.7.3",
  "description": "Blocks ads on YouTube - video ad breaks, banners and in-feed promos. One toggle, light and dark.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "AdCuck",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "https://*.github.io/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube-ads",
        "enabled": true,
        "path": "rules/network.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "src/content/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "src/inject/interceptor.js",
        "src/inject/adfree.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "src/filters/filters.js",
        "src/content/cosmetic.js",
        "src/content/watchdog.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "src/content/toggle.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "commands": {
    "toggle-blocking": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Toggle ad blocking on or off"
    }
  }
}
